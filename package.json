{
  "name": "cmms-platform",
  "version": "1.0.0",
  "description": "Modern Modular CMMS Platform for General Maintenance",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*",
    "shared/*",
    "core/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@cmms/api",
    "dev:web": "npm run dev --workspace=@cmms/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=@cmms/api",
    "build:web": "npm run build --workspace=@cmms/web",
    "db:migrate": "npm run db:migrate --workspace=@cmms/api",
    "db:seed": "npm run db:seed --workspace=@cmms/api",
    "db:studio": "npm run db:studio --workspace=@cmms/api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test --workspaces",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "husky": "^8.0.3",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
