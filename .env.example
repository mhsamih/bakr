# Database Configuration
DATABASE_URL="postgresql://cmms_user:cmms_password@localhost:5432/cmms_db"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production-abc123xyz789"
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Application Configuration
NODE_ENV="development"
PORT=3001
API_URL="http://localhost:3001"

# Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="CMMS Platform"

# WhatsApp Configuration (CallMeBot - Free)
WHATSAPP_API_KEY=""
WHATSAPP_ENABLED=false

# Email Configuration (Optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@cmms.local"
EMAIL_ENABLED=false

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Session Configuration
SESSION_SECRET="session-secret-key-change-in-production"
