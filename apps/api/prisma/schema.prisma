// CMMS Platform Database Schema
// Modular architecture supporting future expansion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USER MANAGEMENT MODULE
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          Role      @default(TECHNICIAN)
  department    String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  assignedWorkOrders     WorkOrder[]              @relation("AssignedTechnician")
  createdWorkOrders      WorkOrder[]              @relation("CreatedBy")
  completedWorkOrders    WorkOrder[]              @relation("CompletedBy")
  notifications          Notification[]
  auditLogs              AuditLog[]
  activityLogs           ActivityLog[]
  technicianProfile      TechnicianProfile?
  refreshToken           RefreshToken?

  @@index([email])
  @@index([role])
  @@map("users")
}

enum Role {
  ADMIN
  MAINTENANCE_MANAGER
  SUPERVISOR
  TECHNICIAN
  REQUESTER
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// TECHNICIAN MANAGEMENT MODULE
// ============================================

model TechnicianProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String   @unique
  skills         String[]
  specializations String[]
  certifications String[]
  availability   Availability @default(AVAILABLE)
  currentWorkload Int      @default(0)
  maxWorkload    Int      @default(10)
  hireDate       DateTime?
  rating         Float    @default(0.0)
  completedTasks Int      @default(0)

  @@map("technician_profiles")
}

enum Availability {
  AVAILABLE
  BUSY
  ON_LEAVE
  OFF_DUTY
}

// ============================================
// ASSET MANAGEMENT MODULE
// ============================================

model Building {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  country     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floors      Floor[]
  assets      Asset[]
  workOrders  WorkOrder[]

  @@index([code])
  @@map("buildings")
}

model Floor {
  id          String   @id @default(uuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String
  level       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms       Room[]
  assets      Asset[]

  @@unique([buildingId, level])
  @@index([buildingId])
  @@map("floors")
}

model Room {
  id          String   @id @default(uuid())
  floorId     String
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  type        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@index([floorId])
  @@map("rooms")
}

model AssetCategory {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  parentId    String?
  parent      AssetCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    AssetCategory[] @relation("CategoryHierarchy")
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]
  pmTemplates PMTemplate[]

  @@index([code])
  @@map("asset_categories")
}

model Asset {
  id                String       @id @default(uuid())
  assetId           String       @unique
  name              String
  categoryId        String?
  category          AssetCategory? @relation(fields: [categoryId], references: [id])
  model             String?
  serialNumber      String?
  manufacturer      String?
  purchaseDate      DateTime?
  warrantyExpiration DateTime?
  purchasePrice     Float?
  status            AssetStatus  @default(ACTIVE)
  priority          Priority     @default(MEDIUM)
  qrCode            String?
  barcode           String?
  description       String?
  specifications    Json?
  images            String[]
  documents         String[]
  
  // Location
  buildingId        String?
  building          Building?    @relation(fields: [buildingId], references: [id])
  floorId           String?
  floor             Floor?       @relation(fields: [floorId], references: [id])
  roomId            String?
  room              Room?        @relation(fields: [roomId], references: [id])
  locationDetails   String?

  // Hierarchy
  parentId          String?
  parent            Asset?       @relation("AssetHierarchy", fields: [parentId], references: [id])
  children          Asset[]      @relation("AssetHierarchy")

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  // Relations
  workOrders        WorkOrder[]
  pmSchedules       PMSchedule[]
  inventoryItems    InventoryItem[]
  maintenanceHistory MaintenanceRecord[]
  movementHistory   AssetMovement[]

  @@index([assetId])
  @@index([status])
  @@index([categoryId])
  @@index([buildingId])
  @@map("assets")
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  FAULTY
  OUT_OF_SERVICE
  RETIRED
}

model AssetMovement {
  id          String   @id @default(uuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromLocation String?
  toLocation   String?
  movedBy     String
  reason      String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([assetId])
  @@map("asset_movements")
}

model MaintenanceRecord {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrderId   String?
  type          String
  description   String
  performedBy   String?
  duration      Int?     // in minutes
  cost          Float?
  partsUsed     Json?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([assetId])
  @@map("maintenance_records")
}

// ============================================
// WORK ORDER MANAGEMENT MODULE
// ============================================

model WorkOrder {
  id              String         @id @default(uuid())
  woNumber        String         @unique
  title           String
  description     String?
  type            WorkOrderType  @default(CORRECTIVE)
  priority        Priority       @default(MEDIUM)
  status          WorkOrderStatus @default(OPEN)
  slaDeadline     DateTime?
  dueDate         DateTime?
  
  // Location
  buildingId      String?
  building        Building?      @relation(fields: [buildingId], references: [id])
  
  // Asset
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id])
  
  // People
  requesterId     String?
  requester       User?          @relation("CreatedBy", fields: [requesterId], references: [id])
  assignedToId    String?
  assignedTo      User?          @relation("AssignedTechnician", fields: [assignedToId], references: [id])
  completedById   String?
  completedBy     User?          @relation("CompletedBy", fields: [completedById], references: [id])
  
  // Tracking
  estimatedHours  Float?
  actualHours     Float?
  laborCost       Float?
  totalCost       Float?
  
  // Content
  checklist       Json?
  attachments     String[]
  comments        WorkOrderComment[]
  activityTimeline ActivityTimeline[]
  
  // Signatures
  customerSignature String?
  technicianSignature String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  closedAt        DateTime?

  @@index([woNumber])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([assetId])
  @@map("work_orders")
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  EMERGENCY
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_PARTS
  WAITING_APPROVAL
  COMPLETED
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model WorkOrderComment {
  id          String   @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId    String
  content     String
  attachments String[]
  isInternal  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workOrderId])
  @@map("work_order_comments")
}

model ActivityTimeline {
  id          String   @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  action      String
  description String
  performedBy String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workOrderId])
  @@map("activity_timeline")
}

// ============================================
// PREVENTIVE MAINTENANCE MODULE
// ============================================

model PMTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  categoryId      String?
  category        AssetCategory? @relation(fields: [categoryId], references: [id])
  intervalType    IntervalType @default(DAILY)
  intervalValue   Int      @default(1)
  estimatedDuration Int    @default(60)
  priority        Priority @default(MEDIUM)
  checklist       Json?
  instructions    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pmSchedules     PMSchedule[]

  @@map("pm_templates")
}

enum IntervalType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model PMSchedule {
  id              String   @id @default(uuid())
  templateId      String?
  template        PMTemplate? @relation(fields: [templateId], references: [id])
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  intervalType    IntervalType
  intervalValue   Int
  lastPerformed   DateTime?
  nextDue         DateTime
  status          PMScheduleStatus @default(ACTIVE)
  autoGenerateWO  Boolean  @default(true)
  assignedToId    String?
  checklist       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  generatedWorkOrders WorkOrder[]

  @@index([assetId])
  @@index([nextDue])
  @@index([status])
  @@map("pm_schedules")
}

enum PMScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// ============================================
// INVENTORY & SPARE PARTS MODULE
// ============================================

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String?
  manager     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  website     String?
  rating      Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model InventoryItem {
  id            String   @id @default(uuid())
  sku           String   @unique
  name          String
  description   String?
  categoryId    String?
  category      AssetCategory? @relation(fields: [categoryId], references: [id])
  
  // Stock
  quantity      Int      @default(0)
  minStock      Int      @default(0)
  maxStock      Int?
  unit          String   @default("piece")
  
  // Location
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  binLocation   String?
  
  // Pricing
  costPrice     Float?
  sellingPrice  Float?
  
  // Supplier
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  
  // Asset relation (for spare parts linked to assets)
  assetId       String?
  asset         Asset?   @relation(fields: [assetId], references: [id])
  
  // Tracking
  reorderPoint  Int?
  leadTime      Int?     // days
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([sku])
  @@index([warehouseId])
  @@map("inventory_items")
}

model StockMovement {
  id            String   @id @default(uuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  type          MovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  notes         String?
  performedBy   String?
  createdAt     DateTime @default(now())

  @@index([itemId])
  @@index([warehouseId])
  @@map("stock_movements")
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

// ============================================
// NOTIFICATIONS MODULE
// ============================================

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  data       Json?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
  WORK_ORDER_ASSIGNED
  WORK_ORDER_UPDATED
  WORK_ORDER_OVERDUE
  PM_DUE
  PM_OVERDUE
  INVENTORY_LOW
  INVENTORY_OUT_OF_STOCK
  ASSET_FAULTY
  GENERAL
}

// ============================================
// AUDIT & ACTIVITY LOGS
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  module     String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@map("activity_logs")
}
